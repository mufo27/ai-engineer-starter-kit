# ── App ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
JWT_SECRET=change-me-in-production-use-a-long-random-string

# ── Database ─────────────────────────────────────────
POSTGRES_USER=kit
POSTGRES_PASSWORD=kit_dev_password
POSTGRES_DB=ai_kit
DATABASE_URL=postgresql+asyncpg://kit:kit_dev_password@localhost:5432/ai_kit

# ── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM Providers (fill your own keys; app runs in mock mode if empty) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
DEFAULT_MODEL=mock

# ── Cost / Budget guardrails ─────────────────────────
DEFAULT_TOKEN_BUDGET=1000000        # per-tenant monthly token ceiling
ALERT_COST_THRESHOLD_USD=50.0

# ── Rate limits ──────────────────────────────────────
RATE_LIMIT_QPS=10
RATE_LIMIT_MONTHLY_REQUESTS=100000

# ── Langfuse (optional, Day 2) ───────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
