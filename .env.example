# ── App ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
JWT_SECRET=change-me-in-production-use-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────
POSTGRES_USER=kit
POSTGRES_PASSWORD=kit_dev_password
POSTGRES_DB=ai_kit
DATABASE_URL=postgresql+asyncpg://kit:kit_dev_password@localhost:5432/ai_kit

# ── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM Providers (fill your own keys; app runs in mock mode if empty) ──
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Google Gemini (native generateContent API)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# OpenAI-compatible vendors (same chat schema, just point base_url + key)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
DEFAULT_MODEL=mock

# ── Cost / Budget guardrails ─────────────────────────
DEFAULT_TOKEN_BUDGET=1000000        # per-tenant monthly token ceiling
ALERT_COST_THRESHOLD_USD=50.0

# ── Rate limits ──────────────────────────────────────
RATE_LIMIT_QPS=10
RATE_LIMIT_MONTHLY_REQUESTS=100000

# ── Langfuse (optional, Day 2) ───────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
